# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
JWT_SECRET=your_jwt_secret_minimum_32_characters_random_string
JWT_EXPIRES_IN=7d

# Hosted Database (PostgreSQL required for internship deployment)
# Example PostgreSQL URL from Neon, Supabase, or Render:
# DATABASE_URL=postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/taskflow?sslmode=require
# If omitted, server falls back to local SQLite database in data/tasks.db
DATABASE_URL=

# Frontend URL (For CORS whitelist in production)
FRONTEND_URL=https://your-frontend-app.vercel.app
